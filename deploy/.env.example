# Ejemplo de configuracion del Collector (Fases 3-4) via variables de entorno.
# Copiar a .env (no committear) o exportar antes de arrancar.

# Conexion a PostgreSQL (obligatoria)
DATABASE_URL="postgres://observer:observer@127.0.0.1:55432/observer"

# Token bearer compartido (obligatorio) - debe coincidir con agent_token
# de cada /etc/observer/agent.conf
OBS_COLLECTOR_TOKEN="cambiame-por-una-secreto-fuerte"

# HTTP
OBS_LISTEN_ADDR="0.0.0.0:8080"

# Piscina de conexiones
OBS_DB_MAX_CONNECTIONS=5

# Validacion temporal de ingestion
OBS_INGEST_FUTURE_SKEW_SECS=60
OBS_INGEST_MAX_AGE_SECS=600

# Limite de body por request (bytes)
OBS_MAX_BODY_BYTES=262144

# Maquina de estados de conectividad (Fase 4, bloque 4.2): un agent esta
# ONLINE si last_seen <= OBS_STATE_ONLINE_SECS, DEGRADED hasta
# OBS_STATE_DEGRADED_SECS y OFFLINE mas alla (base: heartbeat 5s).
OBS_STATE_ONLINE_SECS=15
OBS_STATE_DEGRADED_SECS=60

# Deteccion de reboot (Fase 4, bloque 4.3): caida minima de system.uptime
# entre muestras consecutivas para considerarla un reboot. 0 = cualquier
# caida; 2.0 filtra el redondeo del segundo de /proc/uptime.
OBS_REBOOT_MIN_UPTIME_DROP_SECS=2.0

# Canal de eventos realtime (Fase 6, bloque 6.2): capacidad del broadcast
# WebSocket /api/v1/events. Suscriptores lentos descartan los eventos que
# no alcanzan a consumir (se avisa con events_lagged).
OBS_WS_CHANNEL_CAPACITY=256

# Runner de conectividad (Fase 6, bloque 6.3): cada cuantos segundos se
# recorre todo el parque de agents para detectar transiciones del estado
# derivado (4.2), persistirlas en connectivity_events y publicarlas al WS.
OBS_CONNECTIVITY_POLL_SECS=5

# Dashboard (Fase 7, bloque 7.1): carpeta relativa a CWD con la UI estatica
# (index.html + app.js + style.css) que el collector sirve en su listener.
# Debe existir en disco al arrancar.
OBS_DASHBOARD_DIR="dashboard"

# Nivel de log (tracing): trace|debug|info|warn|error
RUST_LOG="info"